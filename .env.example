# Unicall 真实敏感值环境变量模板
# JS 配置文件负责管理结构；env / secret manager 只负责提供实际敏感值。
# 复制为 .env.local 后填写真实值；不要提交 .env.local 或任何真实秘钥。

# 全局
# 选填：默认 profile 名称。JS 配置和脚本未指定 --profile 时读取该值。
UNICALL_PROFILE=default

# Pushplus（推送加）
# 必填：默认 profile 的用户推送 token。
UNICALL_PUSHPLUS_DEFAULT_TOKEN=
# 选填：默认 profile 的群组编码；不填则给 token 默认接收人推送。
UNICALL_PUSHPLUS_DEFAULT_TOPIC=
# 选填：默认 profile 的内容模板，可填 markdown/html/txt；不填时 JS 配置默认 markdown。
UNICALL_PUSHPLUS_DEFAULT_TEMPLATE=markdown
# 必填：ops profile 的用户推送 token；不用 ops profile 可留空。
UNICALL_PUSHPLUS_OPS_TOKEN=
# 选填：ops profile 的群组编码。
UNICALL_PUSHPLUS_OPS_TOPIC=
# 选填：ops profile 的内容模板，可填 markdown/html/txt。
UNICALL_PUSHPLUS_OPS_TEMPLATE=html

# Webhook
# 必填：完整 webhook URL，可包含 method、scheme 等参数。
# 示例：webhook://example.com/notice?method=POST
UNICALL_WEBHOOK_DEFAULT_URL=webhook://example.com/notice?method=POST

# 喵提醒（简易模式）
# 必填：个人喵码。简易文本推送只需要这个字段。
# 选填高级字段：app/type/option 等建议写在 unicall.config.local.mjs，不放 env。
UNICALL_MIAOTIXING_DEFAULT_ID=

# WxPusher
# 必填：标准应用的 appToken。
UNICALL_WXPUSHER_DEFAULT_APP_TOKEN=
# 个人推送必填：接收人的 UID 列表，多个用英文逗号分隔。
UNICALL_WXPUSHER_DEFAULT_UIDS=
# 群发选填：主题 ID 列表，多个用英文逗号分隔；如果只推送个人可不填。
UNICALL_WXPUSHER_DEFAULT_TOPIC_IDS=
# 说明：至少填写 uids 或 topicIds 其中一个。
# 说明：SPT 属于极简推送模式，不等同于标准应用的 UID，当前标准 Provider 使用 appToken + uids/topicIds。

# Email / SMTP
# 不同邮箱默认 SMTP host/port 在代码 smtpPresets 中维护。
# 这里只保留通用发信必填项；文本/HTML/模板字段请放到 unicall.config.local.mjs 的 templates.email 中。
# 必填（二选一）：邮箱服务名称。可填 qq、foxmail、163、gmail、outlook、hotmail。
UNICALL_EMAIL_DEFAULT_SERVICE=
# 必填（二选一）：SMTP 服务器地址；如果填写，会优先覆盖 service 默认 host。
UNICALL_EMAIL_DEFAULT_HOST=
# 选填：SMTP 端口；如果填写，会优先覆盖 service 默认端口。
UNICALL_EMAIL_DEFAULT_PORT=
# 选填：是否使用 SSL 直连。true 常用 465；false 常用 STARTTLS 587；不填则按 service 默认值。
UNICALL_EMAIL_DEFAULT_SECURE=
# 必填：SMTP 登录账号，通常是完整邮箱地址。
UNICALL_EMAIL_DEFAULT_USER=
# 必填：SMTP 授权码或密码；QQ/163/Gmail 通常需要授权码或应用专用密码，不是网页登录密码。
UNICALL_EMAIL_DEFAULT_PASS=
# 必填：发件邮箱地址。
UNICALL_EMAIL_DEFAULT_FROM=
# 选填：发件人昵称，例如 云端效率大师。
UNICALL_EMAIL_DEFAULT_FROM_NAME=
# 必填：收件人邮箱列表，多个用英文逗号分隔。
UNICALL_EMAIL_DEFAULT_TO=
