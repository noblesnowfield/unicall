# Unicall 真实敏感值环境变量模板
# JS 配置文件负责管理结构；env / secret manager 只负责提供实际敏感值。
# 复制为 .env.local 后填写真实值；不要提交 .env.local 或任何真实秘钥。

# 默认 profile。JS 配置和脚本未指定 profile 时读取该值。
UNICALL_PROFILE=default

# Pushplus
UNICALL_PUSHPLUS_DEFAULT_TOKEN=
UNICALL_PUSHPLUS_DEFAULT_TOPIC=
UNICALL_PUSHPLUS_DEFAULT_TEMPLATE=markdown
UNICALL_PUSHPLUS_OPS_TOKEN=
UNICALL_PUSHPLUS_OPS_TOPIC=
UNICALL_PUSHPLUS_OPS_TEMPLATE=html

# Webhook
UNICALL_WEBHOOK_DEFAULT_URL=webhook://example.com/notice?method=POST

# 喵提醒
UNICALL_MIAOTIXING_DEFAULT_ID=
UNICALL_MIAOTIXING_DEFAULT_APP=
UNICALL_MIAOTIXING_DEFAULT_TYPE=json
UNICALL_MIAOTIXING_DEFAULT_OPTION=

# WxPusher
UNICALL_WXPUSHER_DEFAULT_APP_TOKEN=
UNICALL_WXPUSHER_DEFAULT_UIDS=
UNICALL_WXPUSHER_DEFAULT_TOPIC_IDS=

# Email / SMTP
UNICALL_EMAIL_DEFAULT_HOST=
UNICALL_EMAIL_DEFAULT_PORT=465
UNICALL_EMAIL_DEFAULT_SECURE=true
UNICALL_EMAIL_DEFAULT_USER=
UNICALL_EMAIL_DEFAULT_PASS=
UNICALL_EMAIL_DEFAULT_FROM=
UNICALL_EMAIL_DEFAULT_FROM_NAME=
UNICALL_EMAIL_DEFAULT_TO=

# Email / QQ / Foxmail
# 真实授权码填写到 .env.local 的 UNICALL_EMAIL_QQ_PASS，不要提交。
UNICALL_EMAIL_QQ_USER=
UNICALL_EMAIL_QQ_PASS=
UNICALL_EMAIL_QQ_FROM=
UNICALL_EMAIL_QQ_FROM_NAME=云端效率大师
UNICALL_EMAIL_QQ_TO=

# Email / 163
UNICALL_EMAIL_163_USER=
UNICALL_EMAIL_163_PASS=
UNICALL_EMAIL_163_FROM=
UNICALL_EMAIL_163_FROM_NAME=
UNICALL_EMAIL_163_TO=

# Email / Gmail
UNICALL_EMAIL_GMAIL_USER=
UNICALL_EMAIL_GMAIL_PASS=
UNICALL_EMAIL_GMAIL_FROM=
UNICALL_EMAIL_GMAIL_FROM_NAME=
UNICALL_EMAIL_GMAIL_TO=
