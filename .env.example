# Unicall 真实敏感值环境变量模板
# JS 配置文件负责管理结构；env / secret manager 只负责提供实际敏感值。
# 复制为 .env.local 后填写真实值；不要提交 .env.local 或任何真实秘钥。

# 全局
# UNICALL_PROFILE
# 作用：指定默认 profile 名称，用于从 JS 配置中选择 channels.<channel>.<profile>。
# 必填：否。未填写时默认使用 default。
# 场景：本地想默认测试 ops、prod、qq 等 profile 时填写。
UNICALL_PROFILE=default

# Pushplus（推送加）
# UNICALL_PUSHPLUS_DEFAULT_TOKEN
# 作用：Pushplus 默认 profile 的用户推送 token，用于认证发送接口。
# 必填：是。使用 pushplus/default 发送时必须填写。
# 场景：个人推送或默认接收人推送。
UNICALL_PUSHPLUS_DEFAULT_TOKEN=

# UNICALL_PUSHPLUS_DEFAULT_TOPIC
# 作用：Pushplus 默认 profile 的群组编码，用于推送到指定群组。
# 必填：否。不填写时发送给 token 对应的默认接收人。
# 场景：需要群组推送时填写。
UNICALL_PUSHPLUS_DEFAULT_TOPIC=

# UNICALL_PUSHPLUS_DEFAULT_TEMPLATE
# 作用：Pushplus 默认 profile 的消息模板类型。
# 必填：否。可填 markdown、html、txt；不填写时 JS 配置默认 markdown。
# 场景：想用 HTML 或纯文本格式推送时修改。
UNICALL_PUSHPLUS_DEFAULT_TEMPLATE=markdown

# UNICALL_PUSHPLUS_OPS_TOKEN
# 作用：Pushplus ops profile 的用户推送 token。
# 必填：否。只有使用 pushplus/ops profile 时才需要填写。
# 场景：运维告警、生产环境和默认账号分开时填写。
UNICALL_PUSHPLUS_OPS_TOKEN=

# UNICALL_PUSHPLUS_OPS_TOPIC
# 作用：Pushplus ops profile 的群组编码，用于发送到运维群组。
# 必填：否。不填写时发送给 ops token 默认接收人。
# 场景：运维群组推送时填写。
UNICALL_PUSHPLUS_OPS_TOPIC=

# UNICALL_PUSHPLUS_OPS_TEMPLATE
# 作用：Pushplus ops profile 的消息模板类型。
# 必填：否。可填 markdown、html、txt。
# 场景：ops 告警希望使用 HTML 或 Markdown 时填写。
UNICALL_PUSHPLUS_OPS_TEMPLATE=html

# Webhook
# UNICALL_WEBHOOK_DEFAULT_URL
# 作用：默认 Webhook 通知地址，可包含 method、scheme 等参数。
# 必填：是。使用 webhook/default 发送时必须填写。
# 场景：推送到自建服务、自动化平台、第三方 Webhook。
# 示例：webhook://example.com/notice?method=POST
UNICALL_WEBHOOK_DEFAULT_URL=webhook://example.com/notice?method=POST

# 喵提醒（简易模式）
# UNICALL_MIAOTIXING_DEFAULT_ID
# 作用：喵提醒个人喵码，用于确定提醒发送到哪个提醒单。
# 必填：是。简易文本推送只需要填写这个字段。
# 场景：个人实时提醒、轻量告警。
# 选填高级字段：app/type/option 等建议写在 unicall.config.local.mjs，不放 env。
UNICALL_MIAOTIXING_DEFAULT_ID=

# WxPusher
# UNICALL_WXPUSHER_DEFAULT_APP_TOKEN
# 作用：WxPusher 标准应用 appToken，用于认证标准推送接口。
# 必填：是。使用 wxpusher/default 发送时必须填写。
# 场景：标准应用推送到 UID 或主题。
UNICALL_WXPUSHER_DEFAULT_APP_TOKEN=

# UNICALL_WXPUSHER_DEFAULT_UIDS
# 作用：WxPusher 接收人 UID 列表，多个用英文逗号分隔。
# 必填：个人推送时必填。若只使用 topicIds 群发，可不填。
# 场景：给一个或多个指定用户推送。
UNICALL_WXPUSHER_DEFAULT_UIDS=

# UNICALL_WXPUSHER_DEFAULT_TOPIC_IDS
# 作用：WxPusher 主题 ID 列表，多个用英文逗号分隔。
# 必填：主题群发时必填。若只使用 uids 个人推送，可不填。
# 场景：给关注某个主题的用户群发。
UNICALL_WXPUSHER_DEFAULT_TOPIC_IDS=
# 说明：至少填写 uids 或 topicIds 其中一个。
# 说明：SPT 属于极简推送模式，不等同于标准应用的 UID，当前标准 Provider 使用 appToken + uids/topicIds。

# Email / SMTP
# 不同邮箱默认 SMTP host/port 在代码 smtpPresets 中维护。
# 这里只保留通用发信必填项；文本/HTML/模板字段请放到 unicall.config.local.mjs 的 templates.email 中。
# UNICALL_EMAIL_DEFAULT_SERVICE
# 作用：邮箱服务名称，用于自动补全 SMTP host、port、secure。
# 必填：service 和 host 二选一。可填 qq、foxmail、163、gmail、outlook、hotmail。
# 场景：使用常见邮箱服务时推荐填写。
UNICALL_EMAIL_DEFAULT_SERVICE=

# UNICALL_EMAIL_DEFAULT_HOST
# 作用：SMTP 服务器地址。
# 必填：service 和 host 二选一。如果填写，会优先覆盖 service 默认 host。
# 场景：使用企业邮箱、自建 SMTP 或自定义服务器时填写。
UNICALL_EMAIL_DEFAULT_HOST=

# UNICALL_EMAIL_DEFAULT_PORT
# 作用：SMTP 端口。
# 必填：否。如果填写，会优先覆盖 service 默认端口。
# 场景：自定义端口、企业邮箱或代理 SMTP。
UNICALL_EMAIL_DEFAULT_PORT=

# UNICALL_EMAIL_DEFAULT_SECURE
# 作用：是否使用 SSL 直连。
# 必填：否。true 通常对应 465；false 通常对应 STARTTLS 587；不填则按 service 默认值。
# 场景：邮箱服务要求指定 SSL/STARTTLS 时填写。
UNICALL_EMAIL_DEFAULT_SECURE=

# UNICALL_EMAIL_DEFAULT_USER
# 作用：SMTP 登录账号，通常是完整邮箱地址。
# 必填：是。发送邮件时用于 SMTP 认证。
# 场景：例如 xihua2023@foxmail.com。
UNICALL_EMAIL_DEFAULT_USER=

# UNICALL_EMAIL_DEFAULT_PASS
# 作用：SMTP 授权码或密码。
# 必填：是。QQ/163/Gmail 通常需要授权码或应用专用密码，不是网页登录密码。
# 场景：在邮箱后台开启 SMTP 后生成并填写。
UNICALL_EMAIL_DEFAULT_PASS=

# UNICALL_EMAIL_DEFAULT_FROM
# 作用：发件邮箱地址，会写入邮件 From。
# 必填：是。通常与 SMTP 登录账号一致，也可能是允许的别名地址。
# 场景：收件人看到的发件邮箱。
UNICALL_EMAIL_DEFAULT_FROM=

# UNICALL_EMAIL_DEFAULT_FROM_NAME
# 作用：发件人昵称，会显示在邮件客户端发件人名称处。
# 必填：否。不填时只显示发件邮箱。
# 场景：例如 云端效率大师、运维通知。
UNICALL_EMAIL_DEFAULT_FROM_NAME=

# UNICALL_EMAIL_DEFAULT_TO
# 作用：收件人邮箱列表，多个用英文逗号分隔。
# 必填：是。发送测试邮件或真实邮件时使用。
# 场景：例如 beichen2023@qq.com,xihua2023@foxmail.com。
UNICALL_EMAIL_DEFAULT_TO=
